{
  "name": "proposal-guard",
  "version": "0.0.0",
  "description": "Deterministic scope-creep checker for draft proposals and statements of work. Not legal advice.",
  "private": true,
  "license": "MIT",
  "author": "Arsalan Arshad",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc --noEmit -p demo",
    "test": "vitest run",
    "eval": "tsx eval/run.ts",
    "build:demo": "node demo/build.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "bin": {
    "proposal-guard": "./dist/bin.js",
    "proposal-guard-mcp": "./dist/mcp.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "4.6.7"
  }
}
